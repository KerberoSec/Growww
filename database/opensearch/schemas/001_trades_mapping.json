{
  "settings": {
    "index": {
      "number_of_shards": 5,
      "number_of_replicas": 2,
      "refresh_interval": "1s"
    }
  },
  "mappings": {
    "properties": {
      "trade_id": { "type": "keyword" },
      "isin": { "type": "keyword" },
      "symbol": { "type": "keyword" },
      "buyer_order_id": { "type": "keyword" },
      "seller_order_id": { "type": "keyword" },
      "buyer_address": { "type": "keyword" },
      "seller_address": { "type": "keyword" },
      "fractional_units": { "type": "scaled_float", "scaling_factor": 1000000 },
      "price_per_unit_inr": { "type": "scaled_float", "scaling_factor": 10000 },
      "gross_amount_inr": { "type": "scaled_float", "scaling_factor": 10000 },
      "fee_amount_inr": { "type": "scaled_float", "scaling_factor": 10000 },
      "settlement_status": { "type": "keyword" },
      "on_chain_tx_hash": { "type": "keyword" },
      "on_chain_block_num": { "type": "long" },
      "executed_at": { "type": "date" }
    }
  }
}
